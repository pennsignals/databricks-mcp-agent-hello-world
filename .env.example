# Copy to .env for local overrides and convenience.
# Databricks auth should normally come from CLI profiles for local development.
# workspace-config.yml is the main project config file.

DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
LLM_ENDPOINT_NAME=your-llm-endpoint-name
LOG_LEVEL=INFO
MAX_AGENT_STEPS=8

# Optional overrides used only when the matching YAML value is omitted or null.
# AGENT_SYSTEM_PROMPT_PATH=prompts/agent_system_prompt.txt
# DATABRICKS_MCP_SERVER_NAME=uc_functions
# DATABRICKS_MCP_SERVER_URL=https://your-workspace.cloud.databricks.com/api/2.0/mcp/functions/catalog/schema
# AGENT_EVENTS_TABLE=main.agent.agent_events
# LOCAL_DATA_DIR=./.local_state
